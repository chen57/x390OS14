<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "">
<plist version="1.0">
<dict>
    <!-- 注：这是一个精简并注释过的模板。请在本地用 ProperTree/PlistEditPro/OpenCore Configurator 等工具打开并根据你的硬件调整每一项。 -->
    <key>ACPI</key>
    <dict>
        <key>Add</key>
        <array>
            <!-- 在这里列出你的 SSDT/AML 文件（本仓仅包含占位文件） -->
            <dict>
                <key>Comment</key><string>Placeholder SSDT</string>
                <key>Enabled</key><true/>
                <key>Path</key><string>ACPI/SSDT-PLACEHOLDER.aml</string>
            </dict>
        </array>
        <key>Delete</key><array/>
        <key>Patch</key><array/>
    </dict>

    <key>Boot</key>
    <dict>
        <key>Arguments</key><string>-v keepsyms=1 debug=0x100</string>
        <key>Timeout</key><integer>5</integer>
    </dict>

    <key>DeviceProperties</key>
    <dict>
        <key>Add</key>
        <dict/>
        <key>Delete</key>
        <dict/>
    </dict>

    <key>Kernel</key>
    <dict>
        <key>Emulate</key>
        <dict/>
        <key>Quirks</key>
        <dict/>
        <key>Patch</key>
        <array/>
        <key>Legacy</key>
        <dict/>
        <key>Add</key>
        <array>
            <!-- 列出需要加载的 kext（仅为示例，实际 kext 需放入 EFI/OC/Kexts） -->
            <dict>
                <key>BundlePath</key><string>Lilu.kext</string>
                <key>Enabled</key><true/>
                <key>Comment</key><string>Lilu (required)</string>
            </dict>
            <dict>
                <key>BundlePath</key><string>VirtualSMC.kext</string>
                <key>Enabled</key><true/>
                <key>Comment</key><string>VirtualSMC and plugins</string>
            </dict>
            <dict>
                <key>BundlePath</key><string>WhateverGreen.kext</string>
                <key>Enabled</key><true/>
            </dict>
            <dict>
                <key>BundlePath</key><string>AppleALC.kext</string>
                <key>Enabled</key><true/>
            </dict>
            <dict>
                <key>BundlePath</key><string>IntelMausi.kext</string>
                <key>Enabled</key><true/>
                <key>Comment</key><string>Intel Ethernet driver (示例)</string>
            </dict>
        </array>
    </dict>

    <key>NVRAM</key>
    <dict>
        <key>Add</key>
        <dict>
            <key>7C436110-AB2A-4BBB-A880-FE41995C9F82</key>
            <dict>
                <key>boot-args</key>
                <string>-v keepsyms=1</string>
                <key>csr-active-config</key>
                <data>AAAA</data>
            </dict>
        </dict>
        <key>Delete</key>
        <dict/>
    </dict>

    <key>PlatformInfo</key>
    <dict>
        <!-- 强烈建议使用 ProperTree 的 GenSMBIOS 或 macserial 等工具生成合法的 SMBIOS 信息并只在本地替换以下占位 -->
        <key>Generic</key>
        <dict>
            <key>SystemProductName</key><string>MacBookPro15,2</string> <!-- 根据需求替换 -->
            <key>SystemSerialNumber</key><string>REPLACE_ME_SERIAL</string>
            <key>MLB</key><string>REPLACE_ME_MLB</string>
            <key>SystemUUID</key><string>REPLACE_ME_SMUUID</string>
            <key>ROM</key><string>REPLACE_ME_ROM</string>
        </dict>
    </dict>

    <key>UEFI</key>
    <dict>
        <key>Drivers</key>
        <array>
            <!-- 需要的 UEFI drivers（示例: OpenRuntime, HfsPlus等），请根据 OpenCore 版本选择 -->
            <string>OpenRuntime.efi</string>
            <string>VBoxHfs.efi</string>
        </array>
        <key>APFS</key>
        <dict/>
    </dict>

    <key>Misc</key>
    <dict>
        <key>Debug</key>
        <dict>
            <key>Enable</key><false/>
        </dict>
        <key>Security</key>
        <dict/>
    </dict>
</dict>
</plist>
